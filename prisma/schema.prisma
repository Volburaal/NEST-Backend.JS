generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int        @id @default(autoincrement())
  name        String
  email       String     @unique
  password    String
  role        Role
  affiliation String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  reviews     Proposal[] @relation("ReviewedProposals")
  proposals   Proposal[] @relation("SubmittedProposals")
}

model Proposal {
  id               Int            @id @default(autoincrement())
  title            String
  society          String
  venue            String @default("Default Venue")
  description      String
  eventDate        DateTime
  posters          Json?
  budget           Float
  status           ProposalStatus @default(PENDING)
  comments         String?
  submittedById    Int
  reviewedById     Int?
  nextReviewerRole Role?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  reviewedBy       User?          @relation("ReviewedProposals", fields: [reviewedById], references: [id])
  submittedBy      User           @relation("SubmittedProposals", fields: [submittedById], references: [id])
}

enum Role {
  STUDENT
  MENTOR
  STUDENT_AFFAIRS
  DIRECTOR
  FINANCE_MANAGER
}

enum ProposalStatus {
  PENDING
  APPROVED
  REJECTED
  REVISED
}
