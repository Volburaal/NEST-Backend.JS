generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int           @id @default(autoincrement())
  name        String
  email       String        @unique
  password    String
  role        Role
  affiliation String?      // Society name or department
  designation String?      // Temporarily optional to avoid migration issues
  tenureStart DateTime?    // Temporarily optional to avoid migration issues
  tenureEnd   DateTime?    // When the role/position ends (null if ongoing)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  reviews     Proposal[]    @relation("ReviewedProposals")
  proposals   Proposal[]    @relation("SubmittedProposals")
  comments    Comment[]     @relation("UserComments")
  roleHistory RoleHistory[]
}

model Proposal {
  id               Int            @id @default(autoincrement())
  title            String
  society          String
  venue            String         @default("Default Venue")
  description      String
  eventDate        DateTime
  posters          Json?
  budget           Float
  status           ProposalStatus @default(PENDING)
  submittedById    Int
  reviewedById     Int?
  nextReviewerRole Role?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  reviewedBy       User?          @relation("ReviewedProposals", fields: [reviewedById], references: [id])
  submittedBy      User           @relation("SubmittedProposals", fields: [submittedById], references: [id])
  comments         Comment[]      @relation("ProposalComments")
  files            File[]
}

model Comment {
  id         Int      @id @default(autoincrement())
  content    String
  createdAt  DateTime @default(now())
  userId     Int
  proposalId Int
  user       User     @relation("UserComments", fields: [userId], references: [id])
  proposal   Proposal @relation("ProposalComments", fields: [proposalId], references: [id])
}

enum Role {
  STUDENT
  MENTOR           
  STUDENT_AFFAIRS  
  DIRECTOR        
  FINANCE_MANAGER 
}

enum ProposalStatus {
  PENDING
  APPROVED
  REJECTED
  REVISED
}

model RoleHistory {
  id          Int       @id @default(autoincrement())
  userId      Int
  user        User      @relation(fields: [userId], references: [id])
  role        Role
  designation String?    
  affiliation String?   
  startDate   DateTime
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
}

model File {
  id          Int       @id @default(autoincrement())
  filename    String
  path        String
  uploadedAt  DateTime  @default(now())
  proposal    Proposal  @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  proposalId  Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([proposalId])
}
